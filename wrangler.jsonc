{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "testagram-web",
  "compatibility_date": "2026-10-03",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "testagram.site",
      "custom_domain": true
    },
    {
      "pattern": "www.testagram.site",
      "custom_domain": true
    }
  ]
}
