{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "testagram-web",
  "main": "cloudflare/index.ts",
  "compatibility_date": "2026-10-03",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/.well-known/*",
      "/nodeinfo/*",
      "/users/*",
      "/inbox",
      "/oauth/*"
    ]
  },
  "routes": [
    { "pattern": "testagram.site/*", "zone_name": "testagram.site" },
    { "pattern": "www.testagram.site/*", "zone_name": "testagram.site" }
  ],
  "triggers": {
    "crons": ["17 3 * * *"]
  }
}
