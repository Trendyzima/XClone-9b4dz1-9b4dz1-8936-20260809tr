{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "testagram-web",
  "main": "cloudflare/index.ts",
  "compatibility_date": "2026-10-03",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/.well-known/*",
      "/nodeinfo/*",
      "/users/*",
      "/inbox",
      "/oauth/*",
      "/",
      "/explore",
      "/videos",
      "/video",
      "/shorts",
      "/threads",
      "/communities",
      "/spaces",
      "/spaces/*",
      "/discover",
      "/discover/*",
      "/fediverse",
      "/fediverse/*",
      "/help",
      "/tv",
      "/tv/*",
      "/iptv",
      "/news",
      "/news/*",
      "/leaderboard",
      "/leaderboard/*",
      "/hashtags",
      "/products",
      "/marketplace",
      "/shop",
      "/series",
      "/premium",
      "/ai",
      "/policy",
      "/privacy",
      "/terms",
      "/search",
      "/hashtag/*",
      "/trending/*",
      "/challenge/*",
      "/c/*",
      "/profile/*",
      "/thread/*",
      "/post/*",
      "/stream/*",
      "/channel/*",
      "/seller/*",
      "/auth",
      "/auth/*",
      "/login",
      "/login/*",
      "/signup",
      "/signup/*",
      "/messages",
      "/messages/*",
      "/notifications",
      "/notifications/*",
      "/wallet",
      "/wallet/*",
      "/settings",
      "/settings/*",
      "/bookmarks",
      "/bookmarks/*",
      "/history",
      "/history/*",
      "/scheduled",
      "/scheduled/*",
      "/payouts",
      "/payouts/*",
      "/creator-studio",
      "/creator-studio/*",
      "/monetization",
      "/monetization/*",
      "/analytics",
      "/analytics/*",
      "/verify",
      "/verify/*",
      "/verify-identity",
      "/verify-identity/*",
      "/referral",
      "/referral/*",
      "/rewards",
      "/rewards/*",
      "/platform-inbox",
      "/platform-inbox/*",
      "/interests",
      "/interests/*",
      "/notification-preferences",
      "/notification-preferences/*",
      "/lists",
      "/lists/*",
      "/my-ads",
      "/my-ads/*",
      "/create-ad",
      "/create-ad/*",
      "/start-stream",
      "/start-stream/*",
      "/ad-analytics",
      "/ad-analytics/*",
      "/ad-performance",
      "/ad-performance/*",
      "/post-analytics",
      "/post-analytics/*",
      "/boost-analytics",
      "/boost-analytics/*",
      "/boost-create",
      "/boost-create/*",
      "/admin",
      "/admin/*",
      "/fraud-detection",
      "/fraud-detection/*",
      "/seo-audit",
      "/seo-audit/*",
      "/staff",
      "/staff/*",
      "/regulator",
      "/regulator/*",
      "/team-chat",
      "/team-chat/*",
      "/appeals",
      "/appeals/*",
      "/orders",
      "/orders/*",
      "/sessions",
      "/sessions/*",
      "/blocked",
      "/blocked/*",
      "/daily-rewards",
      "/daily-rewards/*",
      "/wishlist",
      "/wishlist/*",
      "/call",
      "/call/*",
      "/tv-studio",
      "/tv-studio/*",
      "/profile/complete",
      "/profile/complete/*"
    ]
  },
  "routes": [
    {
      "pattern": "testagram.site",
      "custom_domain": true
    },
    {
      "pattern": "www.testagram.site",
      "custom_domain": true
    }
  ],
  "triggers": {
    "crons": [
      "17 3 * * *"
    ]
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "907103",
      "simple": {
        "limit": 600,
        "period": 60
      }
    }
  ],
  "cache": {
    "enabled": true
  }
}
