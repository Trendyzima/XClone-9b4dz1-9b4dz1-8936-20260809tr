[Unit]
Description=Testagram Identity Engine
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=testagram-identity
Group=testagram-identity
WorkingDirectory=/opt/testagram/identity-engine
EnvironmentFile=/etc/testagram/identity-engine.env
ExecStart=/usr/bin/python3 -m uvicorn src.server:app --host 127.0.0.1 --port 8787 --workers 2
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/testagram/identity-engine
MemoryDenyWriteExecute=true
LockPersonality=true
RestrictSUIDSGID=true
