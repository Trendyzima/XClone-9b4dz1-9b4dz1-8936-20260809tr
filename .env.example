# Fresh Testagram frontend configuration.
# Appwrite owns identity. The Go Backend owns application authorization and data.
# Never put Appwrite server keys, B2/R2 credentials, or Cloudflare signing secrets in VITE_*.

VITE_APPWRITE_ENDPOINT=https://<REGION>.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=

VITE_TESTAGRAM_AUTH_PROVIDER=appwrite
VITE_TESTAGRAM_FRESH_MODE=true
VITE_TESTAGRAM_SELF_HOSTED=false

# Public origin of the Go Backend API. No service token is required in the browser;
# the frontend obtains a short-lived Appwrite JWT for authenticated API requests.
VITE_TESTAGRAM_FRESH_API_URL=https://api.testagram.site
VITE_TESTAGRAM_API_URL=https://api.testagram.site

# Public Federation service origin. XClone proxies local ActivityPub actor lookups through this service.
TESTAGRAM_FEDERATION_API_URL=https://federation.testagram.site

# Cloudflare media delivery hostname. Private URLs are short-lived and signed by Backend.
VITE_TESTAGRAM_CDN_ENABLED=true
VITE_TESTAGRAM_CDN_URL=https://media.testagram.site

# Analytics is optional. Do not send authentication secrets or identity evidence to analytics.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Optional feature flags. Enable only after the corresponding Backend APIs are deployed.
VITE_TESTAGRAM_UNIFIED_FEED_ENABLED=false

# their PostgREST, Realtime, Storage and Edge Function contracts are ported to Backend.

