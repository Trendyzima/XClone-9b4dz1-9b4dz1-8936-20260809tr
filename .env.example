# Testagram Supabase project
# Browser-safe client configuration only. VITE_* values are bundled into the public frontend.
# Browser-safe configuration. The publishable key is intended for client-side use.
VITE_SUPABASE_URL=https://ffrhglgkukgsuhxenena.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_h51Z3EHP2LN5o7HdRAB3Og_uhUA3oya
# Legacy variable name accepted during migration; prefer VITE_SUPABASE_PUBLISHABLE_KEY.
VITE_SUPABASE_ANON_KEY=

# Secondary Supabase project (legacy/expanded data plane)
# Keep this project isolated from the primary project's auth/session; JWTs are not interchangeable.
VITE_SUPABASE_SECONDARY_URL=https://aepbqfrmheihfsauzcby.supabase.co
VITE_SUPABASE_SECONDARY_PUBLISHABLE_KEY=sb_publishable_f331BL1gsNy-otXRmQPtrw_SG8tCWLn

# Server-only Supabase API configuration
# NEVER prefix secrets with VITE_ and NEVER commit real secret keys.
# Configure these in the backend/deployment secret store, not in browser builds.
SUPABASE_URL=https://ffrhglgkukgsuhxenena.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_h51Z3EHP2LN5o7HdRAB3Og_uhUA3oya
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://ffrhglgkukgsuhxenena.supabase.co/auth/v1/.well-known/jwks.json

# Secondary project server-side settings (fill secrets in the deployment secret store).
SUPABASE_SECONDARY_URL=https://aepbqfrmheihfsauzcby.supabase.co
SUPABASE_SECONDARY_PUBLISHABLE_KEY=sb_publishable_f331BL1gsNy-otXRmQPtrw_SG8tCWLn
SUPABASE_SECONDARY_SECRET_KEY=
SUPABASE_SECONDARY_JWKS_URL=https://aepbqfrmheihfsauzcby.supabase.co/auth/v1/.well-known/jwks.json

# Testagram analytics
# Create a PostHog project and copy its project API key here.
VITE_POSTHOG_KEY=
# US cloud default. For EU cloud use https://eu.i.posthog.com
# For a self-hosted PostHog deployment use your PostHog ingestion URL.
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Ride service is first-party and runs inside Testagram Supabase; no external URL is required.

# Self-hosted live TV CDN (video transport only; never put the signing secret in Vite)
VITE_TESTAGRAM_CDN_ENABLED=true
VITE_TESTAGRAM_CDN_URL=https://media.testagram.site

# Testagram-owned identity verification engine (server-side only; never Vite)
# IDENTITY_PREAUTH_SECRET / IDENTITY_ENGINE_SECRET live in Supabase Function secrets.

# Testagram-owned mail service (server-side only; never Vite)
TESTAGRAM_MAIL_URL=https://mail.testagram.site
TESTAGRAM_MAIL_TOKEN=

# Optional self-hosted Testagram API origin. When set, browser media uploads use
# /api/media/upload-intent -> bounded Go API PUT -> /api/media/complete; post attachments,
# private downloads and deletions use the self-hosted API. The backend must have migration
# 007 applied and its server-only SUPABASE_SERVICE_ROLE_KEY configured for post linking.
# For a fully self-hosted build set VITE_TESTAGRAM_SELF_HOSTED=true and configure
# VITE_SUPABASE_URL + VITE_SUPABASE_PUBLISHABLE_KEY to the owned Supabase-compatible
# endpoint, plus this API URL. Self-hosted mode refuses hosted URL fallbacks.
# Leave VITE_TESTAGRAM_SELF_HOSTED unset/false only for the legacy hosted build.
# Example after owned DNS/TLS are configured: https://api.testagram.site
VITE_TESTAGRAM_SELF_HOSTED=false
VITE_TESTAGRAM_API_URL=

# Server-side Vercel API capability routing (not VITE_*; never bundled into the browser).
# Enable only after the owned Go API is deployed and reachable from this API runtime.
# Self-hosted mode fails closed and does not fall back to hosted Supabase.
TESTAGRAM_SELF_HOSTED=false
TESTAGRAM_API_URL=https://api.testagram.site
