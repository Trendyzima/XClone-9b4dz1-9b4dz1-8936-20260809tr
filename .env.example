# Testagram frontend — Appwrite identity and the centralized Backend API.
# VITE_* values are public and are bundled into browser assets. Never put secrets here.
VITE_TESTAGRAM_FRESH_MODE=true
VITE_TESTAGRAM_AUTH_PROVIDER=appwrite
VITE_APPWRITE_ENDPOINT=https://<REGION>.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=
VITE_TESTAGRAM_API_URL=https://api.testagram.site
VITE_TESTAGRAM_FRESH_API_URL=https://api.testagram.site
VITE_API_URL=https://api.testagram.site
TESTAGRAM_BACKEND_API_URL=https://api.testagram.site

# Frontend analytics
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# First-party media delivery. Upload authorization and object verification are
# performed by Backend; B2 is primary and Cloudflare R2 is the verified replica.
VITE_TESTAGRAM_CDN_ENABLED=true
VITE_TESTAGRAM_CDN_URL=https://media.testagram.site

# Feature flags remain disabled until their Backend routes and end-to-end tests pass.
VITE_TESTAGRAM_UNIFIED_FEED_ENABLED=false

# Server-side deployment settings. Configure these only in the Backend/worker
# secret manager; never prefix secrets with VITE_ and never commit real values.
APPWRITE_ENDPOINT=https://<REGION>.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
NEON_DATABASE_URL=

B2_S3_ENDPOINT=
B2_S3_REGION=us-west-004
B2_S3_ACCESS_KEY_ID=
B2_S3_SECRET_ACCESS_KEY=
B2_S3_BUCKET=

CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_REGION=auto
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=

CLOUDFLARE_MEDIA_BASE_URL=
CLOUDFLARE_MEDIA_SIGNING_SECRET=

# Testagram-owned identity verification and email delivery services.
IDENTITY_PREAUTH_SECRET=
IDENTITY_ENGINE_SECRET=
TESTAGRAM_MAIL_URL=https://mail.testagram.site
TESTAGRAM_MAIL_TOKEN=

# Internal service credentials are server-only and must be independently
# generated per service. Never expose these through frontend build variables.
TESTAGRAM_INTERNAL_API_TOKEN=
FEDERATION_INTERNAL_TOKEN=
ALGORITHM_INTERNAL_TOKEN=
DATA_CENTRE_INTERNAL_TOKEN=
