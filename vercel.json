{
  "installCommand": "sed -i '/^node-options/d' .npmrc && npm install && node _patch-vite.cjs",
  "buildCommand": "node _build.cjs",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/.well-known/webfinger", "destination": "https://aepbqfrmheihfsauzcby.supabase.co/functions/v1/mastodon-federation/.well-known/webfinger" },
    { "source": "/.well-known/nodeinfo", "destination": "https://aepbqfrmheihfsauzcby.supabase.co/functions/v1/mastodon-federation/.well-known/nodeinfo" },
    { "source": "/nodeinfo/2.0", "destination": "https://aepbqfrmheihfsauzcby.supabase.co/functions/v1/mastodon-federation/nodeinfo/2.0" },
    { "source": "/users/:username", "destination": "https://aepbqfrmheihfsauzcby.supabase.co/functions/v1/mastodon-federation/users/:username" },
    { "source": "/users/:username/:collection(followers|following|outbox)", "destination": "https://aepbqfrmheihfsauzcby.supabase.co/functions/v1/mastodon-federation/users/:username/:collection" },
    { "source": "/users/:username/inbox", "destination": "https://aepbqfrmheihfsauzcby.supabase.co/functions/v1/mastodon-federation/users/:username/inbox" },
    { "source": "/inbox", "destination": "https://aepbqfrmheihfsauzcby.supabase.co/functions/v1/mastodon-federation/inbox" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/(.*)\\.js", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/(.*)\\.css", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/sitemap.xml", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }, { "key": "Content-Type", "value": "application/xml" }] },
    { "source": "/sitemap-static.xml", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }, { "key": "Content-Type", "value": "application/xml" }] },
    { "source": "/sitemap-community.xml", "headers": [{ "key": "Cache-Control", "value": "public, max-age=21600" }, { "key": "Content-Type", "value": "application/xml" }] },
    { "source": "/robots.txt", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }, { "key": "Content-Type", "value": "text/plain" }] },
    { "source": "/(.*)", "headers": [{ "key": "X-Frame-Options", "value": "SAMEORIGIN" }, { "key": "X-Content-Type-Options", "value": "nosniff" }, { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }, { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }] },
    { "source": "/", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] }
  ]
}