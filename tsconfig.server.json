{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": ".runtime",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "noEmitOnError": true,
    "sourceMap": false
  },
  "include": ["api/**/*.ts"],
  "exclude": ["node_modules", "api/tv-cloudflare-ingest.ts", "api/tv-youtube-ingest.ts"]
}
