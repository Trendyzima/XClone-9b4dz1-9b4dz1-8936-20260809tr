# Fresh Testagram frontend build — no Supabase configuration.
VITE_TESTAGRAM_FRESH_MODE=true
VITE_TESTAGRAM_AUTH_PROVIDER=appwrite
VITE_TESTAGRAM_FRESH_API_URL=https://api.testagram.site
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=
VITE_TESTAGRAM_API_URL=https://api.testagram.site

# Server-only origin used by the XClone Edge proxy for public ActivityPub actor documents.
TESTAGRAM_FEDERATION_API_URL=https://federation.testagram.site
